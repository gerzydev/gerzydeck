{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gerzys Deck",
  "mainBinaryName": "gerzys-deck",
  "version": "0.1.0",
  "identifier": "cz.gerzy.deck",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Gerzy's deck", "width": 1200, "height": 760, "minWidth": 900, "minHeight": 600, "visible": false, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
